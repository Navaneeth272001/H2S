# PostgreSQL Settings
POSTGRES_USER=h2s_user
POSTGRES_PASSWORD=h2s_pass
POSTGRES_DB=h2s_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Email Notification Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=contact@example.com

# Pipeline Configuration
POLL_INTERVAL=60
MINUTES_PER_HOUR=60
MAX_ERRORS=2

# Open-Meteo Configuration
LAT=48.8566
LON=2.3522
TIMEZONE=Europe/Paris

# MQTT Broker (Local Mosquitto on the Pi — h2s_agent subscribes here and forwards signed envelopes to cloud)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USER=h2s-agent
MQTT_PASSWORD=your_local_mqtt_password
MQTT_CLIENT_ID=h2s-collector

AGENT_UUID=your_agent_uuid
AES_DEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Heartbeat interval (seconds) — DevOps recommends 60s for etat
HEARTBEAT_INTERVAL=60

# Local Mosquitto topics read by h2s_agent
MQTT_TOPIC_BATTERY_STATUS=h2s/site4/battery/status
MQTT_TOPIC_BATTERY_COMMANDS=h2s/site4/commands
MQTT_TOPIC_WEATHER_STATUS=h2s/site4/weather/status

# Battery telemetry source: simulation (default) or socketry (Jackery cloud API)
BATTERY_ENABLED=true
BATTERY_SOURCE=simulation
BATTERY_NAME=Jackery Explorer
BATTERY_STOCK_ID=1
# Peak virtual renewable generation at 1,000 W/m² GHI; simulation only (no panels assumed).
BATTERY_SIMULATED_CHARGE_W=500
# Starting point used only when no prior simulated battery sample exists.
BATTERY_INITIAL_SOC=85
JACKERY_EMAIL=
JACKERY_PASSWORD=
JACKERY_DEVICE_SN=

# Renewable production digital twin (SOLAR + WIND, published as source="device" under their device_id)
# Override with JSON if your site declares different production device IDs in the cloud admin:
# PRODUCTION_SOURCES_JSON={"20":{"name":"ROOFTOP PV (SIMULATED)","type":"SOLAR","surface_m2":10.0,"efficiency":0.22},"21":{"name":"WIND TURBINE (SIMULATED)","type":"WIND","rotor_diameter_m":3.0,"efficiency":0.35,"cut_in_m_s":3.0,"cut_out_m_s":25.0,"rated_power_w":2000.0}}
PRODUCTION_SOURCES_JSON=

# Shelly relay control is non-actuating by default. Configure actual hardware
# IPs/channels/roles in SHELLY_DEVICES_JSON before selecting hardware mode.
SHELLY_EXECUTION_MODE=simulation
SHELLY_PHYSICAL_COMMANDS_ENABLED=false
SHELLY_COMMAND_TIMEOUT_SECONDS=5
SHELLY_MAX_RETRIES=2
SHELLY_EFFECT_THRESHOLD_W=5
# JSON object keyed by H2S device ID. Roles: priority, non_critical, monitor_only.
# Each entry supports name, ip, role, switch_id, measurement_component, protocol.
# Example: {"8":{"name":"TV","ip":"192.168.1.20","role":"priority","switch_id":0,"measurement_component":"switch:0","protocol":"gen2_rpc"}}
SHELLY_DEVICES_JSON=
