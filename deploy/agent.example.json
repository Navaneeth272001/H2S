{
  "cloud_url": "https://dev.h2splug.com",
  "db_url": "postgresql://h2s_agent:h2s_agent@127.0.0.1:5432/h2s_agent",
  "data_dir": "/var/lib/h2s-agent",
  "package_public_key": null,
  "key_store": "software",
  "tpm_tcti": "device:/dev/tpmrm0",
  "require_tpm": false,
  "mqtt": {
    "host": "127.0.0.1",
    "port": 1883,
    "username": "h2s-agent",
    "password_file": "/etc/h2s-agent/mqtt.password"
  },
  "devices": [
    { "device_id": 8, "kind": "h2s_json", "topic": "h2s/devices/8/status", "role": "CONSUMPTION" },
    { "device_id": 9, "kind": "h2s_json", "topic": "h2s/devices/9/status", "role": "CONSUMPTION" },
    { "device_id": 10, "kind": "h2s_json", "topic": "h2s/devices/10/status", "role": "CONSUMPTION" },
    { "device_id": 11, "kind": "h2s_json", "topic": "h2s/devices/11/status", "role": "CONSUMPTION" },
    { "device_id": 12, "kind": "h2s_json", "topic": "h2s/devices/12/status", "role": "CONSUMPTION" },
    { "device_id": 13, "kind": "h2s_json", "topic": "h2s/devices/13/status", "role": "CONSUMPTION" },
    { "device_id": 14, "kind": "h2s_json", "topic": "h2s/devices/14/status", "role": "CONSUMPTION" },
    { "device_id": 15, "kind": "h2s_json", "topic": "h2s/devices/15/status", "role": "CONSUMPTION" }
  ],
  "batteries": [
    { "stock_id": 1, "status_topic": "h2s/site4/battery/status", "command_prefix": "h2s/site4/commands" }
  ],
  "weather_topic": "h2s/site4/weather/status",
  "local_api_port": 8765,
  "device_offline_after_s": 300
}
