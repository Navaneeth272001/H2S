{
  "cloud_url": "https://dev.h2splug.com",
  "db_url": "postgresql://h2s_agent:h2s_agent@127.0.0.1:5432/h2s_agent",
  "data_dir": "/var/lib/h2s-agent",
  "package_public_key": null,
  "key_store": "software",
  "tpm_tcti": "device:/dev/tpmrm0",
  "require_tpm": false,
  "mqtt": {
    "host": "127.0.0.1",
    "port": 1883,
    "username": "h2s-agent",
    "password_file": "/etc/h2s-agent/mqtt.password"
  },
  "devices": [
    { "device_id": 2001, "kind": "h2s_json", "topic": "h2s/devices/2001/status", "role": "CONSUMPTION" },
    { "device_id": 2002, "kind": "h2s_json", "topic": "h2s/devices/2002/status", "role": "CONSUMPTION" },
    { "device_id": 2003, "kind": "h2s_json", "topic": "h2s/devices/2003/status", "role": "CONSUMPTION" },
    { "device_id": 2004, "kind": "h2s_json", "topic": "h2s/devices/2004/status", "role": "CONSUMPTION" },
    { "device_id": 2005, "kind": "h2s_json", "topic": "h2s/devices/2005/status", "role": "CONSUMPTION" },
    { "device_id": 2006, "kind": "h2s_json", "topic": "h2s/devices/2006/status", "role": "CONSUMPTION" },
    { "device_id": 2007, "kind": "h2s_json", "topic": "h2s/devices/2007/status", "role": "CONSUMPTION" },
    { "device_id": 2008, "kind": "h2s_json", "topic": "h2s/devices/2008/status", "role": "CONSUMPTION" }
  ],
  "batteries": [
    { "stock_id": 1, "status_topic": "h2s/site4/battery/status", "command_prefix": "h2s/site4/commands" }
  ],
  "weather_topic": "h2s/site4/weather/status",
  "local_api_port": 8765,
  "device_offline_after_s": 300
}
